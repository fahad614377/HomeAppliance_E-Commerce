<%- include('partials/header') %>

<div style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 130px); padding: 24px; background: linear-gradient(180deg, #ecfdf5 0%, var(--bg-page) 50%);">
    <div style="background: var(--bg-card); padding: 40px; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); max-width: 450px; width: 100%; border: 1px solid var(--border);">
        <div style="text-align: center; margin-bottom: 28px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, var(--success), #059669); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; font-size: 1.5rem; color: white;">&#128221;</div>
            <h2 style="margin: 0; font-size: 1.6rem; font-weight: 900; border: none; padding: 0; letter-spacing: -0.5px;">Create Account</h2>
            <p style="color: var(--text-secondary); margin-top: 6px; font-size: 0.88rem;">Join HomeNest to start shopping</p>
        </div>
        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 18px; font-size: 0.88rem; text-align: center; font-weight: 600;"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 18px; font-size: 0.88rem; text-align: center; font-weight: 600;"><%= success %></div>
        <% } %>
        <form action="/register" method="POST">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.8px;">Full Name</label>
                <input type="text" name="fullName" placeholder="e.g. Rahim Uddin" required style="width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-size: 0.92rem; outline: none; box-sizing: border-box; font-family: inherit; transition: border-color var(--transition);" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.8px;">Username</label>
                <input type="text" name="username" placeholder="e.g. rahim_uddin" required style="width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-size: 0.92rem; outline: none; box-sizing: border-box; font-family: inherit; transition: border-color var(--transition);" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.8px;">Password</label>
                <input type="password" name="password" placeholder="Choose a password" required style="width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-size: 0.92rem; outline: none; box-sizing: border-box; font-family: inherit; transition: border-color var(--transition);" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.8px;">Phone Number</label>
                <input type="tel" name="phone" placeholder="e.g. 01712345678" required style="width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-size: 0.92rem; outline: none; box-sizing: border-box; font-family: inherit; transition: border-color var(--transition);" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">
            </div>
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.8px;">Delivery Address</label>
                <textarea name="address" rows="2" placeholder="House 42, Road 11, Dhanmondi, Dhaka" required style="width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-size: 0.92rem; outline: none; box-sizing: border-box; font-family: inherit; resize: none; transition: border-color var(--transition);" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"></textarea>
            </div>
            <button type="submit" style="background: linear-gradient(135deg, var(--success), var(--success-hover)); color: white; border: none; padding: 14px; border-radius: var(--radius-sm); font-weight: 700; font-size: 0.92rem; width: 100%; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 4px 14px rgba(16,185,129,0.3); transition: all var(--transition);" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='translateY(0)'">Create Account</button>
        </form>
        <div style="text-align: center; font-size: 0.88rem; margin-top: 20px;">
            <span style="color: var(--text-muted);">Already have an account?</span>
            <a href="/login" style="color: var(--accent); font-weight: 700; margin-left: 4px;">Sign In</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
