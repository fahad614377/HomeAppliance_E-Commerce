<%- include('partials/header') %>

<div class="full-page-container" style="background: linear-gradient(180deg, #f8fafc, var(--bg-page));">
    <div class="log-container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <div>
                <h2 style="margin: 0; border: none; padding: 0; font-size: 1.4rem;">Sales Log</h2>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 4px;"><strong><%= sales.length %></strong> total records</p>
            </div>
            <a href="/admin/inventory" style="background: var(--primary-light); color: white; padding: 9px 18px; border-radius: var(--radius-sm); font-size: 0.82rem; font-weight: 700;">Back to Admin</a>
        </div>
        <% if (sales.length === 0) { %>
            <div style="text-align: center; color: var(--text-muted); padding: 60px 0;">
                <div style="font-size: 3rem; margin-bottom: 12px; opacity: 0.4;">&#128202;</div>
                <p style="font-weight: 600; color: var(--text-secondary);">No sales recorded yet.</p>
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table>
                    <thead><tr><th>Order ID</th><th>Image</th><th>Product</th><th>Customer</th><th>Phone</th><th>Price</th><th>Qty</th><th>Total</th><th>Payment</th><th>Date</th></tr></thead>
                    <tbody>
                        <% sales.forEach(function(sale) { %>
                            <tr>
                                <td><span class="badge"><%= sale.saleId ? sale.saleId.substring(0, 15) : 'N/A' %>...</span></td>
                                <td><img src="<%= sale.imagePath %>" class="img-thumb" alt="Product"></td>
                                <td><strong><%= sale.productName %></strong></td>
                                <td><div style="font-size: 0.85rem;"><%= sale.customerName || 'N/A' %></div><div style="font-size: 0.72rem; color: var(--text-muted); max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= sale.customerAddress || '' %></div></td>
                                <td style="font-size: 0.85rem; color: var(--text-secondary);"><%= sale.customerPhone || 'N/A' %></td>
                                <td>BDT <%= sale.price.toFixed(2) %></td>
                                <td>x<%= sale.quantity %></td>
                                <td style="font-weight: 800; color: var(--success);">BDT <%= sale.totalAmount.toFixed(2) %></td>
                                <td><% if (sale.paymentMethod && sale.paymentMethod.includes('Online')) { %><span class="badge-payment badge-online"><%= sale.paymentMethod %></span><% } else { %><span class="badge-payment badge-cod"><%= sale.paymentMethod || 'COD' %></span><% } %></td>
                                <td><small style="color: var(--text-muted);"><%= new Date(sale.saleDate).toLocaleString() %></small></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
